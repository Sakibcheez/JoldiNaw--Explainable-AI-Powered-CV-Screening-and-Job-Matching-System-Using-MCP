CORS_ORIGINS=http://localhost:5173
EMBEDDING_PATH=
EMBEDDING_REVISION=
MCP_HOSTS=localhost,127.0.0.1,localhost:*,127.0.0.1:*
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_CLIENT_ID=
OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
OIDC_SCOPES=openid profile email read write
