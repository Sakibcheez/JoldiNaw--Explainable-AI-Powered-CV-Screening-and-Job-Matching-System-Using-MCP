APP_ENV=development
POSTGRES_DB=joldinaw
POSTGRES_USER=joldinaw
POSTGRES_PASSWORD=local-demo-only-change-me
DATABASE_URL=postgresql+psycopg://joldinaw:local-demo-only-change-me@db:5432/joldinaw
REDIS_URL=redis://redis:6379/0
TASK_MODE=rq
STORAGE_DIR=/app/storage
JWT_SECRET=replace-with-at-least-32-random-characters
